{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands, events, folder picker, confirm dialogs, and opening links to GitHub and Hugging Face in the browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://huggingface.co/*"
        }
      ]
    }
  ]
}
