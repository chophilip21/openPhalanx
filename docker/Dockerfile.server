# Pinned by digest so rebuilds get exactly the SGLang that was tested (0.5.21).
FROM lmsysorg/sglang@sha256:b1259f3ea3275f66237c498ea388919729018bc9f01c3d638391e06e2cf3f469

LABEL org.opencontainers.image.source=https://github.com/chophilip21/openPhalanx \
      org.opencontainers.image.description="OpenPhalanx backend: SGLang inference behind an authenticated gateway"

# supervisor comes from apt so it stays independent of both Python environments.
RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor \
    && rm -rf /var/lib/apt/lists/*

# The gateway gets a small venv of its own so SGLang upgrades can't break it.
# (The coding agent runs on the client; nothing agent-related lives here.)
# Pinned to the versions tested in 0.3.0, so a rebuild of a tag is the same gateway.
RUN uv venv /opt/gateway --python 3.12 \
    && uv pip install --python /opt/gateway/bin/python --no-cache \
        fastapi==0.142.2 starlette==1.7.0 pydantic==2.13.5 "uvicorn[standard]==0.54.0" httpx==0.28.1

COPY server/supervisord.conf /etc/supervisor/conf.d/openphalanx.conf
COPY server/start-sglang.sh /opt/openphalanx/start-sglang.sh
COPY server/gateway.py /opt/openphalanx/gateway.py
RUN chmod +x /opt/openphalanx/start-sglang.sh && mkdir -p /state

ENV MODEL_PATH=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ \
    SERVED_MODEL_NAME=openphalanx-coder \
    SGLANG_PORT=8080 \
    MEM_FRACTION_STATIC=0.85 \
    AGENT_PORT=9090 \
    ADMIN_PORT=9091 \
    STATE_DIR=/state

# 9090: public gateway API (TLS). 9091: admin API; publish on loopback only.
EXPOSE 9090 9091

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
